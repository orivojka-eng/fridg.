# Expo app — only EXPO_PUBLIC_* values. They are compiled into the app binary: never put secrets here.
# Production values for EAS builds live in eas.json (API URL) and EAS environment variables (the rest).
EXPO_PUBLIC_USE_BACKEND=false
# Development on a phone: http://<your PC's LAN IP>:<server PORT>. Release builds: https://<service>.onrender.com
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
# Google sign-in on iPhone: the iOS OAuth client id from Google Cloud (public, not a secret)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Contact address shown in the app and on the legal pages (a free Gmail works)
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_LEGAL_OWNER=
