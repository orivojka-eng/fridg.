# ---- runtime
APP_ENV=development            # development | staging | production
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# ---- database (Neon). DATABASE_URL = pooled connection, DIRECT_URL = direct (migrations)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/fridgr?sslmode=require&pgbouncer=true
DIRECT_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/fridgr?sslmode=require

# ---- auth: Better Auth (generate the secret with: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me-to-a-random-32+-character-secret
# Public URL of this API; used in email links. Production: https only, never localhost/LAN.
# Development on a phone: http://<your PC's LAN IP>:<PORT>
BETTER_AUTH_URL=https://fridgr-api.onrender.com
SESSION_DAYS=30

# ---- Sign in with Apple
APPLE_BUNDLE_ID=com.fridgr.app
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=              # contents of the .p8, newlines as \n

# ---- Google Sign-In: OAuth client ids from console.cloud.google.com (no secret needed for native ID tokens)
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=

# ---- AI (server-side only). Gemini is free (aistudio.google.com) and also watches videos.
# With both keys, Anthropic answers text/photos and Gemini handles videos; AI_PROVIDER forces one.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-flash-latest,gemini-3.5-flash-lite,gemini-flash-lite-latest
GEMINI_MODEL_CHEAP=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3.1-flash-lite
AI_PROVIDER=
ANTHROPIC_API_KEY=
AI_MODEL_PRIMARY=claude-sonnet-5
AI_MODEL_CHEAP=claude-haiku-4-5-20251001

# ---- object storage (Cloudflare R2 / S3)
S3_ENDPOINT=
S3_BUCKET=fridgr-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ---- recipe library (TheMealDB works with the test key 1; a supporter key is needed for a public release)
MEALDB_API_KEY=1
SPOONACULAR_API_KEY=

# ---- data providers
USDA_API_KEY=
YOUTUBE_API_KEY=
META_APP_ID=
META_APP_SECRET=

# ---- email. The first configured provider wins (or force one with EMAIL_PROVIDER=resend|brevo|smtp).
# Without any provider: APP_ENV=development prints emails (and codes) to the log; every other
# environment refuses to send and /health shows email=NOT_CONFIGURED.
# Resend (resend.com, free 3,000/month): needs a verified domain to email other people.
RESEND_API_KEY=
# Brevo (brevo.com, free 300/day): a verified single sender (e.g. your Gmail) is enough.
BREVO_API_KEY=
# SMTP (local/other hosts only; Render free blocks SMTP ports)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_PROVIDER=
# Must be verified at the provider (Resend: an address on your domain; Brevo: the verified sender)
EMAIL_FROM=FRIDGR <hello@fridgr.app>
SUPPORT_INBOX=

# ---- push
EXPO_ACCESS_TOKEN=

# ---- subscriptions
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_SECRET=

# ---- monitoring (optional)
SENTRY_DSN=

# ---- test accounts (local scripts only; never in source)
SEED_DEMO_PASSWORD=      # App Review account review@fridgr.app (npm run db:seed)
DEMO_PASSWORD=           # demo@ / new@fridgr.app (npm run db:demo)
