{
  "name": "fridgr-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p .",
    "typecheck": "tsc --noEmit -p .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:dev": "node scripts/dev-db.mjs",
    "db:import-recipes": "tsx scripts/import-recipes.ts",
    "db:recompute-allergens": "tsx scripts/recompute-allergens.ts",
    "db:demo": "tsx scripts/demo-accounts.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@aws-sdk/client-s3": "^3.1132.0",
    "@aws-sdk/s3-request-presigner": "^3.1132.0",
    "@prisma/client": "5.22.0",
    "argon2": "^0.45.1",
    "better-auth": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "expo-server-sdk": "^7.2.0",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.15",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "5.22.0",
    "resend": "^6.28.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "@types/nodemailer": "^8.0.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "tsx": "^4.23.13",
    "typescript": "^5.2.2"
  }
}
